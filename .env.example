# --- Docker / Portainer ---------------------------------------------------
# Port on the host under which the page is reachable (always 3000 inside the container)
HOST_PORT=3000
# Absolute path on the host for the database & token (empty = Docker volume "welcomescreen-data")
DATA_PATH=/opt/company-welcomescreen/data
# Owner of the files in DATA_PATH
PUID=1000
PGID=1000

# --- App -----------------------------------------------------------------
# Admin token for the admin area, REST write access and MCP
# (empty = generated and saved in DATA_DIR/.admin-token)
ADMIN_TOKEN=
# Public base URL, e.g. https://welcome.example.com (optional)
PUBLIC_URL=
# Time zone for the clock, "today"/"tomorrow" and the day change
APP_TIMEZONE=Europe/Berlin

# --- Initial values for settings (optional, can be changed later in the admin area) ---
# Language of the display and the admin area (en, de – one file per language in locales/)
APP_LANGUAGE=en
# Your own company name for the greeting when no visit is scheduled
SITE_NAME=
# Weather location (Open-Meteo, no API key needed)
WEATHER_LOCATION=Berlin
WEATHER_LATITUDE=52.5200
WEATHER_LONGITUDE=13.4050

# --- Only for running locally without Docker (npm start) ---------------------
# PORT=3000
# DATA_DIR=./data
